@page "/login"
@using System.ComponentModel.DataAnnotations
@inject UserApiClient UserApi
@inject CurrentUserService CurrentUserService
@inject NavigationManager Navigation

<PageTitle>Sign in — UniLab</PageTitle>

<div class="auth-page">
    <div class="auth-card">
        <div class="auth-brand">
            <div class="auth-logo-box">
                <img src="images/logo-unilab.svg" alt="UniLab Logo" class="auth-logo-img" />
            </div>
            <div class="auth-brand-text">
                <span class="auth-brand-name">UniLab</span>
                <span class="auth-brand-sub">RESOURCE MANAGEMENT</span>
            </div>
        </div>

        <div class="auth-header">
            <h1 class="auth-title">Welcome back</h1>
            <p class="auth-subtitle">Sign in to access lab equipment and manage your reservations.</p>
        </div>

        @if (!string.IsNullOrWhiteSpace(errorMessage))
        {
            <div class="auth-alert auth-alert-error" role="alert">
                @errorMessage
            </div>
        }

        <EditForm Model="loginModel" OnValidSubmit="HandleLoginAsync" class="auth-form">
            <DataAnnotationsValidator />

            <div class="form-group">
                <label class="form-label" for="emailOrUsername">Email or username</label>
                <InputText id="emailOrUsername"
                           class="form-input"
                           @bind-Value="loginModel.EmailOrUsername"
                           placeholder="e.g. alex.morgan@university.edu"
                           disabled="@isSubmitting" />
                <ValidationMessage For="@(() => loginModel.EmailOrUsername)" class="field-error" />
            </div>

            <div class="form-group">
                <label class="form-label" for="password">Password</label>
                <InputText id="password"
                           type="password"
                           class="form-input"
                           @bind-Value="loginModel.Password"
                           placeholder="Enter your password"
                           disabled="@isSubmitting" />
                <ValidationMessage For="@(() => loginModel.Password)" class="field-error" />
            </div>

            <button type="submit" class="btn-auth-primary" disabled="@isSubmitting">
                @(isSubmitting ? "Signing in..." : "Sign in")
            </button>
        </EditForm>

        <div class="auth-footer">
            <span>Don't have an account?</span>
            <a href="/register" class="auth-link">Create an account</a>
        </div>
    </div>
</div>

@code {
    private readonly LoginFormModel loginModel = new();
    private bool isSubmitting;
    private string? errorMessage;

    private async Task HandleLoginAsync()
    {
        errorMessage = null;
        isSubmitting = true;

        try
        {
            var dto = new UserLoginDTO(loginModel.EmailOrUsername.Trim(), loginModel.Password);
            var authResponse = await UserApi.loginUserAsync(dto);

            await CurrentUserService.SetCurrentUserAsync(authResponse.id);
            Navigation.NavigateTo("/catalog");
        }
        catch (HttpRequestException)
        {
            errorMessage = "Could not reach the server. Check that the backend API is running.";
        }
        catch (Exception)
        {
            errorMessage = "Invalid email/username or password.";
        }
        finally
        {
            isSubmitting = false;
        }
    }

    private sealed class LoginFormModel
    {
        [Required(ErrorMessage = "Please enter your email or username.")]
        public string EmailOrUsername { get; set; } = string.Empty;

        [Required(ErrorMessage = "Please enter your password.")]
        public string Password { get; set; } = string.Empty;
    }
}