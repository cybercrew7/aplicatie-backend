<div class="user-profile-pill">
    <div class="avatar-circle">
        @if (!string.IsNullOrWhiteSpace(dateUtilizator?.profile_image_url))
        {
            <img src="@dateUtilizator.profile_image_url" alt="User avatar" class="avatar-photo" />
        }
        else
        {
            <img src="images/icon-profile.svg" alt="User avatar" class="avatar-icon" />
        }
    </div>
    <div class="user-info">
        @if (dateUtilizator is not null)
        {
            <span class="user-name">@dateUtilizator.first_name @dateUtilizator.last_name</span>
            <span class="user-role">@dateUtilizator.role.ToString()</span>
        }
        else
        {
            <span class="user-name">Guest</span>
            <span class="user-role">Not signed in</span>
        }
    </div>
</div>

@code {
    [Parameter] public UserMinDTO? dateUtilizator { get; set; }
}
