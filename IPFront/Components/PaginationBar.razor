<footer class="pagination-bar">
    <span class="pagination-summary">
        Showing @StartItemIndex–@EndItemIndex of @TotalItems @ItemLabel
    </span>

    <div class="pagination-controls">
        <button type="button"
                class="page-btn"
                disabled="@(CurrentPage <= 1)"
                @onclick="() => SelectPageAsync(CurrentPage - 1)">
            Previous
        </button>

        @for (int p = 1; p <= TotalPages; p++)
        {
            var pageNumber = p;
            <button type="button"
                    class="page-btn @(pageNumber == CurrentPage ? "active" : string.Empty)"
                    @onclick="() => SelectPageAsync(pageNumber)">
                @pageNumber
            </button>
        }

        <button type="button"
                class="page-btn"
                disabled="@(CurrentPage >= TotalPages)"
                @onclick="() => SelectPageAsync(CurrentPage + 1)">
            Next
        </button>
    </div>
</footer>

@code {
    [Parameter] public int CurrentPage { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 6;
    [Parameter] public int TotalItems { get; set; }
    [Parameter] public string ItemLabel { get; set; } = "items";
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }

    private int TotalPages => TotalItems <= 0 ? 1 : (int)Math.Ceiling((double)TotalItems / PageSize);
    private int StartItemIndex => TotalItems <= 0 ? 0 : ((CurrentPage - 1) * PageSize) + 1;
    private int EndItemIndex => Math.Min(CurrentPage * PageSize, TotalItems);

    private async Task SelectPageAsync(int page)
    {
        if (page < 1 || page > TotalPages || page == CurrentPage)
        {
            return;
        }

        await OnPageChanged.InvokeAsync(page);
    }
}
